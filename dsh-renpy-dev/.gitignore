# ── Ren'Py 开发模式 仓库 .gitignore ───────────────────────────────

# 运行残留（Ren'Py 引擎产物）
.renpy-user/
verification/.test-user/
verification/projects/**/cache/
verification/projects/**/saves/
*.rpyc
*.rpyb
*.pyc
persistent

# 本地环境/工具
node_modules/
*.log
.DS_Store
Thumbs.db

# 编辑器/IDE
.vscode/
.idea/
*.swp

# 临时与归档
*.tmp
*.bak
*.zip
dist/

# 会话提取等本地分析产物（不进仓库）
.preset-staging/
user-messages-*.json
