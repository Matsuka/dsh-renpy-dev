{
  "name": "dsh-renpy-dev-client",
  "version": "0.2.0",
  "license": "MIT",
  "description": "DSH Ren'Py 开发工作台（dsh-renpy-dev）：conversation.view 开发页签 + webServer API（宿主侧）+ 13 个 Ren'Py agent 工具（./tools）",
  "main": "lib/host.js",
  "exports": {
    ".": "./lib/host.js",
    "./client": "./lib/client.js",
    "./tools": "./lib/renpy-host.mjs",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer"
      ],
      "platform": "web"
    }
  }
}
