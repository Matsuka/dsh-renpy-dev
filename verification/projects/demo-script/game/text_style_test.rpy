# 文本样式预览测试：10 行 × 10 个"测"字，逐行叠加不同样式
# 在编辑器中把光标放到某一行，点工具栏「Aa 预览」查看该行样式渲染效果
# （配合降级提示：插值/字体/图片等无法模拟的项会黄色提示）

define e = Character("艾琳")

label text_style_demo:
    # L1 基线：无样式（对照组）
    e "测测测测测测测测测测"

    # L2 粗体
    e "{b}测测测测测测测测测测{/b}"

    # L3 斜体
    e "{i}测测测测测测测测测测{/i}"

    # L4 下划线
    e "{u}测测测测测测测测测测{/u}"

    # L5 删除线
    e "{s}测测测测测测测测测测{/s}"

    # L6 字号 +10
    e "{size=+10}测测测测测测测测测测{/size}"

    # L7 字号 -5
    e "{size=-5}测测测测测测测测测测{/size}"

    # L8 颜色 #ff8888
    e "{color=#ff8888}测测测测测测测测测测{/color}"

    # L9 半透明 alpha=0.5
    e "{alpha=0.5}测测测测测测测测测测{/alpha}"

    # L10 组合：粗体+斜体+下划线+颜色+加大
    e "{b}{i}{u}{color=#88ff88}{size=+6}测测测测测测测测测测{/size}{/color}{/u}{/i}{/b}"

    # L11 字体：Roboto-Light（西文无衬线，细；不含中文字形 → 中文会 fallback，正好演示引擎行为）
    e "{font=fonts/Roboto-Light.ttf}测测测测测测测测测测{/font}"

    # L12 字体：楷体 simkai（中文手写感/楷书，与 Roboto 视觉差异极大）
    e "{font=fonts/simkai.ttf}测测测测测测测测测测{/font}"

    # L13 字体：黑体 simhei（粗壮无衬线，比楷体/Roboto 都更醒目）
    e "{font=fonts/simhei.ttf}测测测测测测测测测测{/font}"

    # L14 速度：极慢 {cps=5}（10 字约 2 秒，逐字看得清）
    e "{cps=5}测测测测测测测测测测{/cps}"

    # L15 速度：慢 {cps=15}
    e "{cps=15}测测测测测测测测测测{/cps}"

    # L16 速度：默认（无 cps 标签 → 读项目配置 slow_cps 30，动画条显示"项目配置"）
    e "测测测测测测测测测测"

    # L17 速度：快 {cps=60}
    e "{cps=60}测测测测测测测测测测{/cps}"

    # L18 速度：极快 {cps=200}（近乎瞬间）
    e "{cps=200}测测测测测测测测测测{/cps}"

    # L19 间隔：{w=1.0} 出 5 字后停顿 1 秒再继续
    e "测测测测测{w=1.0}测测测测测"
    return
